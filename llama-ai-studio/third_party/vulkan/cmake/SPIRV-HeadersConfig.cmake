# Minimal package config for the vendored, header-only SPIRV-Headers (normally generated by
# its `make install`), so ggml-vulkan's find_package(SPIRV-Headers CONFIG REQUIRED) works.
get_filename_component(_spirv_root "${CMAKE_CURRENT_LIST_DIR}/../SPIRV-Headers" ABSOLUTE)
if (NOT TARGET SPIRV-Headers::SPIRV-Headers)
    add_library(SPIRV-Headers::SPIRV-Headers INTERFACE IMPORTED)
    set_target_properties(SPIRV-Headers::SPIRV-Headers PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_spirv_root}/include")
endif()
set(SPIRV-Headers_FOUND TRUE)
